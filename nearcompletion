<#
Safe xp_cmdshell terminator
- Reads PendingValidation candidates
- Validates SQL session and approved Windows process
- Supports DryRun and multiple candidates
- Writes audit events
- Uses return ,$table to avoid DataTable unrolling
- Uses Sort-Object -Unique instead of Group-Object
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory=$true)][string]$SqlServer,
    [Parameter(Mandatory=$true)][string]$Database
)

$ErrorActionPreference = "Stop"

function New-SqlConnection {
    param([string]$Server,[string]$Db)
    $cs = "Server=$Server;Database=$Db;Integrated Security=SSPI;Application Name=XpCmdShellSafeTerminator;TrustServerCertificate=True;"
    $c = New-Object System.Data.SqlClient.SqlConnection $cs
    $c.Open()
    return $c
}

function Invoke-SqlTable {
    param(
        [System.Data.SqlClient.SqlConnection]$Connection,
        [string]$Sql
    )
    $cmd = $Connection.CreateCommand()
    $cmd.CommandText = $Sql
    $cmd.CommandTimeout = 30

    $adapter = New-Object System.Data.SqlClient.SqlDataAdapter $cmd
    $table = New-Object System.Data.DataTable
    [void]$adapter.Fill($table)

    return ,$table
}

function Invoke-SqlNonQuery {
    param(
        [System.Data.SqlClient.SqlConnection]$Connection,
        [string]$Sql,
        [hashtable]$Parameters
    )
    $cmd = $Connection.CreateCommand()
    $cmd.CommandText = $Sql
    $cmd.CommandTimeout = 30

    if ($null -ne $Parameters) {
        foreach ($key in $Parameters.Keys) {
            $value = $Parameters[$key]
            if ($null -eq $value) { $value = [DBNull]::Value }
            [void]$cmd.Parameters.AddWithValue($key,$value)
        }
    }

    [void]$cmd.ExecuteNonQuery()
}

function Write-Audit {
    param(
        [System.Data.SqlClient.SqlConnection]$Connection,
        [long]$CandidateId,
        [string]$EventType,
        [object]$SessionId=$null,
        [object]$ProcessId=$null,
        [object]$ParentProcessId=$null,
        [string]$ProcessName=$null,
        [string]$WindowsAccount=$null,
        [object]$RuntimeMinutes=$null,
        [string]$WaitType=$null,
        [object]$OpenTransactionCount=$null,
        [object]$BlockedSessionCount=$null,
        [string]$RuleName=$null,
        [string]$Message=$null,
        [string]$DetailsJson=$null
    )

    $performedBy = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name

    Invoke-SqlNonQuery -Connection $Connection -Sql @"
EXEC dbo.usp_WriteXpCmdShellTerminationAudit
      @CandidateId=@CandidateId,
      @EventType=@EventType,
      @SessionId=@SessionId,
      @ProcessId=@ProcessId,
      @ParentProcessId=@ParentProcessId,
      @ProcessName=@ProcessName,
      @WindowsAccount=@WindowsAccount,
      @RuntimeMinutes=@RuntimeMinutes,
      @WaitType=@WaitType,
      @OpenTransactionCount=@OpenTransactionCount,
      @BlockedSessionCount=@BlockedSessionCount,
      @RuleName=@RuleName,
      @PerformedBy=@PerformedBy,
      @Message=@Message,
      @DetailsJson=@DetailsJson;
"@ -Parameters @{
        "@CandidateId"=$CandidateId
        "@EventType"=$EventType
        "@SessionId"=$SessionId
        "@ProcessId"=$ProcessId
        "@ParentProcessId"=$ParentProcessId
        "@ProcessName"=$ProcessName
        "@WindowsAccount"=$WindowsAccount
        "@RuntimeMinutes"=$RuntimeMinutes
        "@WaitType"=$WaitType
        "@OpenTransactionCount"=$OpenTransactionCount
        "@BlockedSessionCount"=$BlockedSessionCount
        "@RuleName"=$RuleName
        "@PerformedBy"=$performedBy
        "@Message"=$Message
        "@DetailsJson"=$DetailsJson
    }
}

function Set-CandidateStatus {
    param(
        [System.Data.SqlClient.SqlConnection]$Connection,
        [long]$CandidateId,
        [string]$Status,
        [string]$ValidationMessage=$null,
        [string]$ResultMessage=$null
    )

    Invoke-SqlNonQuery -Connection $Connection -Sql @"
UPDATE dbo.XpCmdShellTerminationCandidate
SET
    Status=@Status,
    ValidationMessage=CASE WHEN @ValidationMessage IS NULL THEN ValidationMessage ELSE @ValidationMessage END,
    ResultMessage=CASE WHEN @ResultMessage IS NULL THEN ResultMessage ELSE @ResultMessage END
WHERE CandidateId=@CandidateId;
"@ -Parameters @{
        "@Status"=$Status
        "@ValidationMessage"=$ValidationMessage
        "@ResultMessage"=$ResultMessage
        "@CandidateId"=$CandidateId
    }
}

function Get-ProcessOwner {
    param([Microsoft.Management.Infrastructure.CimInstance]$Process)
    try {
        $o = Invoke-CimMethod -InputObject $Process -MethodName GetOwner
        if ($o.ReturnValue -eq 0) {
            if ([string]::IsNullOrWhiteSpace($o.Domain)) { return $o.User }
            return "$($o.Domain)\$($o.User)"
        }
    } catch {}
    return $null
}

function Test-ProcessIdentityUnchanged {
    param(
        [int]$ProcessId,
        [datetime]$ExpectedCreationDate,
        [string]$ExpectedName,
        [string]$ExpectedOwner
    )

    $current = Get-CimInstance Win32_Process -Filter "ProcessId = $ProcessId"
    if ($null -eq $current) { return $null }

    $currentStart = [datetime]$current.CreationDate
    if ([Math]::Abs(($currentStart - $ExpectedCreationDate).TotalSeconds) -gt 1) {
        throw "PID $ProcessId creation time changed; possible PID reuse."
    }
    if (-not ([string]$current.Name).Equals($ExpectedName,[System.StringComparison]::OrdinalIgnoreCase)) {
        throw "PID $ProcessId process name changed."
    }

    $currentOwner = Get-ProcessOwner -Process $current
    if (-not [string]::IsNullOrWhiteSpace($currentOwner) -and
        -not $currentOwner.Equals($ExpectedOwner,[System.StringComparison]::OrdinalIgnoreCase)) {
        throw "PID $ProcessId Windows owner changed. Expected '$ExpectedOwner'; observed '$currentOwner'."
    }

    return $current
}

$conn = $null

try {
    Write-Host "Connecting to [$SqlServer] / [$Database]..."
    $conn = New-SqlConnection -Server $SqlServer -Db $Database
    Write-Host "SQL connection successful."

    $config = Invoke-SqlTable -Connection $conn -Sql @"
SELECT TOP (1)
    Enabled,
    MinimumRuntimeMinutes,
    RequireOpenTransaction,
    RequireBlocking,
    MaxTerminationsPerCycle,
    ProcessStartToleranceMinutes,
    DryRun
FROM dbo.XpCmdShellTerminationConfig
ORDER BY ConfigId DESC;
"@

    if ($config.Rows.Count -eq 0) { throw "No configuration row exists." }

    $cfg = $config.Rows[0]
    $enabled = [bool]$cfg.Enabled
    $minimumRuntime = [int]$cfg.MinimumRuntimeMinutes
    $requireOpenTransaction = [bool]$cfg.RequireOpenTransaction
    $requireBlocking = [bool]$cfg.RequireBlocking
    $maxPerCycle = [int]$cfg.MaxTerminationsPerCycle
    $startTolerance = [int]$cfg.ProcessStartToleranceMinutes
    $dryRun = [bool]$cfg.DryRun

    Write-Host "Enabled=$enabled Runtime=$minimumRuntime DryRun=$dryRun MaxPerCycle=$maxPerCycle"

    if (-not $enabled) {
        Write-Host "Monitoring disabled."
        exit 0
    }

    $rules = Invoke-SqlTable -Connection $conn -Sql @"
SELECT RuleId,RuleName,ProcessName,CommandLineContains
FROM dbo.XpCmdShellTerminationRule
WHERE Enabled=1
ORDER BY RuleId;
"@

    if ($rules.Rows.Count -eq 0) {
        Write-Host "No enabled termination rules."
        exit 0
    }

    $candidates = Invoke-SqlTable -Connection $conn -Sql @"
SELECT TOP ($maxPerCycle)
    CandidateId,
    SessionId,
    StartTime,
    RuntimeMinutes,
    WaitType,
    OpenTransactionCount,
    BlockedSessionCount,
    CommandText,
    ProcessId
FROM dbo.XpCmdShellTerminationCandidate
WHERE Status='PendingValidation'
ORDER BY CandidateId;
"@

    if ($candidates.Rows.Count -eq 0) {
        Write-Host "No PendingValidation candidates."
        exit 0
    }

    Write-Host "Pending candidates: $($candidates.Rows.Count)"

    foreach ($candidate in $candidates.Rows) {
        $candidateId = [long]$candidate.CandidateId
        $sessionId = [int]$candidate.SessionId
        $detectedProcessId = if ($candidate.IsNull("ProcessId")) { 0 } else { [int]$candidate.ProcessId }

        try {
            Write-Host "Processing Candidate=$candidateId Session=$sessionId"

            Write-Audit -Connection $conn `
                -CandidateId $candidateId `
                -EventType "ValidationStarted" `
                -SessionId $sessionId `
                -RuntimeMinutes $candidate.RuntimeMinutes `
                -WaitType $candidate.WaitType `
                -OpenTransactionCount $candidate.OpenTransactionCount `
                -BlockedSessionCount $candidate.BlockedSessionCount `
                -Message "PowerShell validation started."

            $live = Invoke-SqlTable -Connection $conn -Sql @"
SELECT
    r.session_id,
    r.start_time,
    DATEDIFF(MINUTE,r.start_time,SYSDATETIME()) AS RuntimeMinutes,
    r.wait_type,
    s.open_transaction_count,
    (
        SELECT COUNT(*)
        FROM sys.dm_exec_requests b
        WHERE b.blocking_session_id=r.session_id
    ) AS BlockedSessionCount,
    txt.text AS SqlText
FROM sys.dm_exec_requests r
JOIN sys.dm_exec_sessions s
  ON s.session_id=r.session_id
OUTER APPLY sys.dm_exec_sql_text(r.sql_handle) txt
WHERE r.session_id=$sessionId;
"@

            if ($live.Rows.Count -ne 1) {
                $msg = "SQL session no longer exists."
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -Message $msg
                continue
            }

            $lr = $live.Rows[0]
            $runtime = [int]$lr.RuntimeMinutes
            $waitType = if ($lr.IsNull("wait_type")) { "" } else { [string]$lr.wait_type }
            $openTran = [int]$lr.open_transaction_count
            $blockedCount = [int]$lr.BlockedSessionCount

            if ($runtime -lt $minimumRuntime) {
                $msg = "SQL session no longer exceeds configured runtime threshold."
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -RuntimeMinutes $runtime -WaitType $waitType -Message $msg
                continue
            }

            if ($requireOpenTransaction -and $openTran -le 0) {
                $msg = "Open transaction required but none exists."
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -Message $msg
                continue
            }

            if ($requireBlocking -and $blockedCount -le 0) {
                $msg = "Blocking required but session is not currently blocking."
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -Message $msg
                continue
            }

            $allProcesses = @(Get-CimInstance Win32_Process)
            $matches = @()

            foreach ($rule in $rules.Rows) {
                $ruleProcess = ([string]$rule["ProcessName"]).Trim()
                if (-not $ruleProcess.EndsWith('.exe',[System.StringComparison]::OrdinalIgnoreCase)) {
                    $ruleProcess += '.exe'
                }
                $ruleContains = if ($rule.IsNull("CommandLineContains")) { "" } else { ([string]$rule["CommandLineContains"]).Trim() }

                $processSearchSet = if ($detectedProcessId -gt 0) {
                    @($allProcesses | Where-Object { [int]$_.ProcessId -eq $detectedProcessId })
                } else {
                    $allProcesses
                }

                $ruleMatches = @(
                    $processSearchSet | Where-Object {
                        $nameMatches = ([string]$_.Name).Equals($ruleProcess,[System.StringComparison]::OrdinalIgnoreCase)
                        $nameMatches
                    }
                )

                foreach ($p in $ruleMatches) {
                    $matches += [PSCustomObject]@{
                        Process=$p
                        RuleName=[string]$rule.RuleName
                    }
                }
            }

            # Fixed: no Group-Object usage.
            $matches = @(
                $matches |
                Sort-Object -Property { $_.Process.ProcessId } -Unique
            )

            if ($matches.Count -eq 0) {
                $msg = if ($detectedProcessId -gt 0) {
                    "Detected PID $detectedProcessId was not found or did not match an enabled database termination rule."
                } else {
                    "No Windows process matched an enabled database termination rule."
                }
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -Message $msg
                continue
            }

            $sqlStart = [datetime]$lr.start_time
            $windowStart = $sqlStart.AddMinutes(-1 * $startTolerance)
            $now = Get-Date

            $timeMatches = @(
                $matches | Where-Object {
                    if ($null -eq $_.Process.CreationDate) { return $false }
                    $dt = [datetime]$_.Process.CreationDate
                    return ($dt -ge $windowStart -and $dt -le $now)
                }
            )

            if ($timeMatches.Count -ne 1) {
                $msg = "Ambiguous Windows process correlation. RuleMatches=$($matches.Count), TimeMatches=$($timeMatches.Count)."
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -RuntimeMinutes $runtime -WaitType $waitType -OpenTransactionCount $openTran -BlockedSessionCount $blockedCount -Message $msg
                continue
            }

            $chosen = $timeMatches[0]
            $p = $chosen.Process

            $targetProcessId = [int]$p.ProcessId
            $parentPid = [int]$p.ParentProcessId
            $processName = [string]$p.Name
            $commandLine = [string]$p.CommandLine
            $processStart = [datetime]$p.CreationDate
            $owner = Get-ProcessOwner -Process $p
            $ruleName = [string]$chosen.RuleName

            if ([string]::IsNullOrWhiteSpace($owner)) {
                $msg = "Windows owner could not be verified during initial process validation."
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationFailed" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationFailed" -SessionId $sessionId -ProcessId $targetProcessId -ParentProcessId $parentPid -ProcessName $processName -RuleName $ruleName -Message $msg
                continue
            }

            Invoke-SqlNonQuery -Connection $conn -Sql @"
UPDATE dbo.XpCmdShellTerminationCandidate
SET
    ProcessId=@ProcessId,
    ParentProcessId=@ParentProcessId,
    ProcessName=@ProcessName,
    ProcessStartTime=@ProcessStartTime,
    WindowsAccount=@WindowsAccount,
    ProcessCommandLine=@ProcessCommandLine,
    Status='Validated',
    ValidationMessage=@ValidationMessage
WHERE CandidateId=@CandidateId
  AND Status='PendingValidation';
"@ -Parameters @{
                "@ProcessId"=$targetProcessId
                "@ParentProcessId"=$parentPid
                "@ProcessName"=$processName
                "@ProcessStartTime"=$processStart
                "@WindowsAccount"=$owner
                "@ProcessCommandLine"=$commandLine
                "@ValidationMessage"="Validated by rule [$ruleName]."
                "@CandidateId"=$candidateId
            }

            $details = @{
                CommandLine=$commandLine
                ProcessStartTime=$processStart
            } | ConvertTo-Json -Compress

            Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationPassed" -SessionId $sessionId -ProcessId $targetProcessId -ParentProcessId $parentPid -ProcessName $processName -WindowsAccount $owner -RuntimeMinutes $runtime -WaitType $waitType -OpenTransactionCount $openTran -BlockedSessionCount $blockedCount -RuleName $ruleName -Message "Windows process validation passed." -DetailsJson $details

            if ($dryRun) {
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "DryRunValidated" -ResultMessage "DRY RUN: process validated; termination not executed."
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "DryRunValidated" -SessionId $sessionId -ProcessId $targetProcessId -ParentProcessId $parentPid -ProcessName $processName -WindowsAccount $owner -RuleName $ruleName -Message "DRY RUN: validated; no termination executed."
                continue
            }

            Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "TerminationRequested"
            Write-Audit -Connection $conn -CandidateId $candidateId -EventType "TerminationRequested" -SessionId $sessionId -ProcessId $targetProcessId -ParentProcessId $parentPid -ProcessName $processName -WindowsAccount $owner -RuleName $ruleName -Message "Termination requested for validated Windows process."

            try {
                $revalidated = Test-ProcessIdentityUnchanged -ProcessId $targetProcessId -ExpectedCreationDate $processStart -ExpectedName $processName -ExpectedOwner $owner
                if ($null -eq $revalidated) {
                    throw "PID $targetProcessId exited before termination."
                }
                Stop-Process -Id $targetProcessId -Force -ErrorAction Stop
                Start-Sleep -Seconds 2

                if (Get-Process -Id $targetProcessId -ErrorAction SilentlyContinue) {
                    throw "PID $targetProcessId is still running after Stop-Process."
                }

                Invoke-SqlNonQuery -Connection $conn -Sql @"
UPDATE dbo.XpCmdShellTerminationCandidate
SET
    Status='Terminated',
    TerminatedAt=SYSDATETIME(),
    ResultMessage=@ResultMessage
WHERE CandidateId=@CandidateId;
"@ -Parameters @{
                    "@CandidateId"=$candidateId
                    "@ResultMessage"="Validated process PID $targetProcessId terminated successfully."
                }

                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "TerminationSucceeded" -SessionId $sessionId -ProcessId $targetProcessId -ParentProcessId $parentPid -ProcessName $processName -WindowsAccount $owner -RuleName $ruleName -Message "Validated Windows process terminated successfully."

                Write-Host "SUCCESS: Candidate=$candidateId PID=$targetProcessId terminated."
            }
            catch {
                $msg = "Termination failed for PID $targetProcessId. $($_.Exception.Message)"
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "TerminationFailed" -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "TerminationFailed" -SessionId $sessionId -ProcessId $targetProcessId -ParentProcessId $parentPid -ProcessName $processName -WindowsAccount $owner -RuleName $ruleName -Message $msg
                Write-Host "FAILED: $msg"
            }
        }
        catch {
            $msg = "Unexpected validation error: $($_.Exception.Message)"

            try {
                Set-CandidateStatus -Connection $conn -CandidateId $candidateId -Status "ValidationError" -ValidationMessage $msg -ResultMessage $msg
                Write-Audit -Connection $conn -CandidateId $candidateId -EventType "ValidationError" -SessionId $sessionId -Message $msg
            }
            catch {
                Write-Host "Unable to persist candidate error: $($_.Exception.Message)"
            }

            Write-Host "ERROR Candidate=$candidateId : $msg"
            continue
        }
    }

    Write-Host "Termination cycle completed."
}
catch {
    Write-Error $_.Exception.Message
    exit 1
}
finally {
    if ($null -ne $conn) {
        $conn.Close()
        $conn.Dispose()
    }
}
