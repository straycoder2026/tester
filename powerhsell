Get-CimInstance Win32_Process |
Where-Object {
    $_.Name -in @("cmd.exe","ping.exe")
} |
Select-Object `
    ProcessId,
    ParentProcessId,
    Name,
    CreationDate,
    CommandLine


SELECT
    RuleName,
    Enabled,
    ProcessName,
    CommandLineContains
FROM dbo.XpCmdShellTerminationRule
WHERE Enabled = 1;
